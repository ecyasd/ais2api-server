# Copy into the persistent /data/.env, outside the release directory.
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PROXY_API_KEY=
WAA_BACKEND=spidermonkey
UPSTREAM_CHANNELS=playground
AUTO_START=true
REQUEST_BODY_LOG=false
FAKE_STREAM=false
STRIP_THOUGHT_SIGNATURES=false
# Recommended capacity; environment variables and saved settings can override it.
# Keep startup concurrency and warm workers no greater than active workers.
WARM_WORKER_LIMIT=1
MAX_ACTIVE_WORKERS=4
WARM_STARTUP_CONCURRENCY=4
PER_ACCOUNT_CONCURRENCY=2
FIRST_EVENT_HEDGE=off
LOG_MAX_TOTAL_MB=50
